  },
  "outputs": {
   "valve_1": {
    "key": "valve_1",
    "on": {
     "hex": "ff1d200000000000000000",
     "payload": {
      "valve_task": {
       "valve_index": "valve 1",
       "sequence_id": 0,
       "valve_status": "open",
       "time_rule_enable": "disable",
       "pulse_rule_enable": "disable",
       "duration": 0,
       "valve_pulse": 0
      }
     }
    },
