       "pulse_rule_enable": "enable",
       "duration": 0,
       "valve_pulse": 1000
      }
     },
     "note": "open until valve_pulse count reached (flow meter pulses)"
    },
    "clear_pulse": {
     "hex": "ff4e0100",
     "payload": {
      "clear_valve_1_pulse": "yes"
     }
    },
    "note": "sequence_id 0 = force execute. valve_task @since hw v4.0/fw v1.1 per encoder. uplink 0x03 0x01 -> valve_1 (0 close/1 open), valve_1_pulse from 0x04 0xC8"
   },
