     "payload": {
      "valve_task": {
       "valve_index": "valve 1",
       "sequence_id": 0,
       "valve_status": "close",
       "time_rule_enable": "disable",
       "pulse_rule_enable": "disable",
       "duration": 0,
       "valve_pulse": 0
      }
     }
    },
    "open_for": {
     "prefix": "ff1da000",
     "value": "u32le",
     "scale": 1,
     "suffix": "000000",
     "unit": "s",
     "min": 1,
     "max": 16777215,
     "payload": {
      "valve_task": {
       "valve_index": "valve 1",
       "sequence_id": 0,
       "valve_status": "open",
       "time_rule_enable": "enable",
       "pulse_rule_enable": "disable",
       "duration": 600,
       "valve_pulse": 0
      }
     },
     "note": "ff1d ctrl seq duration(u24le) pulse(u32le); ctrl=bit7 time rule|bit5 open|valve idx. duration is u24 - encoded here as u32le whose 4th byte (=0) is the first pulse byte; unit not stated in encoder (seconds per UC51x user guide)"
    },
